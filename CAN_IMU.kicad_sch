	)
	(text "To panel mounted 5-pin M12 NMEA2000 \nconnector via soldered pigtail\n\nThe M12 provides CAN and 12V supply"
		(exclude_from_sim no)
		(at 261.366 122.682 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4afe43b0-400c-4d8f-b513-6e87679ba0e9")
	)
	(text "Connector: M50-3110542\nSolderable Nuts (x3): \n	- SMTSOB-256-2ET (Brass)\n	- Or, if not using AHRS with \n	magnetometer, can sub steel \n	keystone 4929\n"
		(exclude_from_sim no)
		(at 190.5 84.582 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "64ad4e0c-a424-4863-9d0c-230ce489113f")
	)
	(text "CAN RX Buffer"
		(exclude_from_sim no)
		(at 125.984 123.952 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "687dc055-79f2-42aa-a4e1-08e8af4736a6")
	)
	(text "3DM-CV7 IMU"
		(exclude_from_sim no)
		(at 227.076 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6b417b91-041e-44cf-ab86-4d36fff60aab")
	)
	(text "Manual Reset Button"
		(exclude_from_sim no)
		(at 144.272 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "71758381-f892-4c87-81ab-969ab7572992")
	)
	(text "CAN_RX is shared with boot0, \nso it is gated until \nsoftware boots"
		(exclude_from_sim no)
		(at 131.064 135.636 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8e229f6e-78ff-4174-b2d6-fa35570770fa")
	)
	(text "MODE_SW: Intended to enable \n	NMEA2000 mode\nBOOT0: Enable the USB DFU \n	bootloader for programming"
		(exclude_from_sim no)
		(at 143.256 102.616 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a7bbd227-d66a-4391-af09-525eaea8fada")
	)
	(text "Switcher\n\nExpected max current draw: ~100mA\n\nDesign should be OK to 500mA, and \nsupport voltages down to 3V so it \ncan run off the USB as well as \nthe 12V supply"
		(exclude_from_sim no)
		(at 239.014 25.146 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dd528974-2de9-4455-a7d0-15c52ea77fef")
	)
	(text "USB-C port, mainly for firmware updating using \nthe STM built-in DFU bootloader"
		(exclude_from_sim no)
